{
  "schema_version": 1,
  "name": "PCR benchmark suite",
  "root": "benchmark",
  "principles": [
    "Findings are risk signals, not misconduct verdicts.",
    "info records are operational status, skip reasons, or coverage notes.",
    "Weak-signal tools are evaluated for surfacing review leads, not for proof.",
    "Network checks are separated because external services can be slow, cached, or temporarily unavailable."
  ],
  "cases": [
    {
      "id": "raw_suspicious",
      "kind": "single_run",
      "input": "inputs/raw_suspicious.csv",
      "expected_tools": ["raw_data_rules"],
      "expected_checks": ["Duplicate rows", "Duplicate columns", "Arithmetic/fixed step", "High frequency value", "Missing concentrated by group", "Terminal digit distribution"],
      "min_risk_findings": 6
    },
    {
      "id": "raw_clean_control",
      "kind": "single_run",
      "input": "inputs/raw_clean_control.csv",
      "expected_tools": [],
      "max_risk_findings": 0
    },
    {
      "id": "summary_suspicious",
      "kind": "single_run",
      "input": "inputs/summary_suspicious.csv",
      "expected_tools": ["crosscheck", "r_scrutiny", "r_rsprite2"],
      "expected_checks": ["SE/SD/√N consistency", "Percent/count consistency", "P-value outside domain", "P-value/t-statistic consistency", "R scrutiny GRIMMER", "R rsprite2 SPRITE"],
      "min_risk_findings": 8
    },
    {
      "id": "p_values_suspicious",
      "kind": "single_run",
      "input": "inputs/p_values_suspicious.csv",
      "expected_tools": ["p_value_distribution"],
      "expected_checks": ["P-value domain", "Marginally significant p-value clustering"],
      "min_risk_findings": 2
    },
    {
      "id": "apa_stats_suspicious",
      "kind": "single_run",
      "input": "inputs/apa_stats_suspicious.txt",
      "expected_tools": ["r_statcheck"],
      "expected_checks": ["R statcheck in-text statistical consistency"],
      "min_risk_findings": 2
    },
    {
      "id": "paper_refs_and_claims_offline",
      "kind": "single_run",
      "input": "inputs/paper_refs_and_claims.md",
      "expected_tools": ["reference_audit", "citation_claim_check", "papermill_light_signals"],
      "expected_checks": ["Reference identifier parsing", "Citation claim extraction"],
      "min_info_findings": 2
    },
    {
      "id": "analysis_suspicious",
      "kind": "single_run",
      "input": "inputs/analysis_suspicious.py",
      "expected_tools": ["code_rerun_audit", "code_rerun_execute"],
      "expected_checks": ["Analysis code rerun readiness check"],
      "min_risk_findings": 1
    },
    {
      "id": "analysis_manual_unsupported",
      "kind": "single_run",
      "input": "inputs/analysis_manual.do",
      "expected_tools": ["code_rerun_audit", "code_rerun_execute"],
      "expected_checks": ["Analysis script rerun unsupported"],
      "min_info_findings": 1
    },
    {
      "id": "figures_project",
      "kind": "project",
      "input": "inputs/figures",
      "expected_tools": ["image_extract", "image_duplicate_internal", "image_copy_move_internal", "image_metadata_audit", "western_blot_review_list", "provenance_hash", "provenance_chain_verify"],
      "expected_checks": ["Internal duplicate image", "Suspected local copy-move region", "Image metadata and quality", "Western blot/gel review checklist"],
      "min_risk_findings": 4
    },
    {
      "id": "project_full",
      "kind": "project",
      "input": "inputs/project_full",
      "expected_tools": ["crosscheck", "r_scrutiny", "provenance_hash", "provenance_chain_verify", "code_rerun_audit", "code_rerun_execute", "data_trace_crosscheck", "reference_audit", "citation_claim_check", "image_duplicate_internal", "image_copy_move_internal", "western_blot_review_list"],
      "expected_checks": ["Raw data/manuscript summary statistics reconciliation", "Analysis script sandbox rerun", "Internal duplicate image"],
      "min_risk_findings": 5
    },
    {
      "id": "corpus_screen",
      "kind": "corpus",
      "input": "inputs/project_full",
      "expected_tools": ["papermill_network_signals"],
      "expected_checks": ["High cross-manuscript text similarity", "Author/email domain network overlap"],
      "min_risk_findings": 2
    },
    {
      "id": "provenance_change",
      "kind": "provenance_change",
      "input": "inputs/project_full",
      "expected_tools": ["provenance_chain_verify"],
      "expected_checks": ["Hash Version Chain Verification"],
      "expected_statuses": ["changed"],
      "min_risk_findings": 1
    },
    {
      "id": "external_refs_online",
      "kind": "project_network",
      "input": "inputs/project_external",
      "expected_tools": ["reference_audit", "citation_claim_check", "provenance_hash"],
      "expected_checks": ["DOI title mismatch", "PMID title mismatch", "DOI external metadata absent", "PMID metadata verification"],
      "expected_external_services": ["crossref", "openalex", "pubpeer", "ncbi"],
      "min_risk_findings": 3
    }
  ]
}
