#!/usr/bin/env Rscript

args <- commandArgs(trailingOnly = TRUE)

usage <- function() {
  cat("Usage: pcr-scrutiny <summary.csv> --scale-min 1 --scale-max 5 --json findings.json\n", file = stderr())
}

json_escape <- function(x) {
  x <- ifelse(is.na(x), "", as.character(x))
  x <- gsub("\\\\", "\\\\\\\\", x)
  x <- gsub("\"", "\\\\\"", x)
  x <- gsub("\n", "\\\\n", x)
  x <- gsub("\r", "\\\\r", x)
  x <- gsub("\t", "\\\\t", x)
  x
}
jstr <- function(x) paste0("\"", json_escape(x), "\"")
confidence_score <- function(confidence, level) {
  if (confidence == "high") return(0.85)
  if (confidence == "medium") return(0.60)
  if (confidence == "low") return(0.30)
  if (level == "info") return(0.10)
  0.60
}
arg_value <- function(flag, default = NULL) {
  if (!(flag %in% args)) return(default)
  pos <- match(flag, args)
  if (pos == length(args)) return(default)
  args[[pos + 1]]
}
finding_json <- function(level, check, target, summary, evidence, detail, suggestion,
                         dependency_status = "ready", confidence = "medium",
                         false_positive_risk = "medium") {
  paste0("{",
    "\"level\":", jstr(level), ",",
    "\"check\":", jstr(check), ",",
    "\"target\":", jstr(target), ",",
    "\"summary\":", jstr(summary), ",",
    "\"evidence\":", jstr(evidence), ",",
    "\"detail\":", jstr(detail), ",",
    "\"suggestion\":", jstr(suggestion), ",",
    "\"meaning\":", jstr(summary), ",",
    "\"normal_explanations\":", jstr("Possible benign causes include the variable not being discrete/integer scored, incorrect scale range setting, different rounding rules, or table extraction errors."), ",",
    "\"review_steps\":", jstr(suggestion), ",",
    "\"confidence\":", jstr(confidence), ",",
    "\"confidence_score\":", sprintf("%.2f", confidence_score(confidence, level)), ",",
    "\"false_positive_risk\":", jstr(false_positive_risk), ",",
    "\"tool_id\":\"r_scrutiny\",",
    "\"tool_name\":\"R scrutiny\",",
    "\"detector_runtime\":\"r\",",
    "\"dependency_status\":", jstr(dependency_status), ",",
    "\"confidence_basis\":", jstr("Generated from R scrutiny feasibility tests, sample size/scale field parseability, and dependency status; requires confirmation of scale range, rounding rules, and variable type."),
  "}")
}
write_payload <- function(source, dependency_status, findings, json_path) {
  payload <- paste0("{\n",
    "  \"tool_id\": \"r_scrutiny\",\n",
    "  \"tool_name\": \"R scrutiny\",\n",
    "  \"detector_runtime\": \"r\",\n",
    "  \"dependency_status\": ", jstr(dependency_status), ",\n",
    "  \"source\": ", jstr(source), ",\n",
    "  \"input_type\": \"summary_statistics_table\",\n",
    "  \"findings\": [", paste(findings, collapse = ","), "]\n",
    "}\n")
  if (!is.null(json_path)) writeLines(payload, json_path, useBytes = TRUE) else cat(payload)
}

if (length(args) < 1) {
  usage()
  quit(status = 2)
}
input <- args[[1]]
json_path <- arg_value("--json")
scale_min <- as.numeric(arg_value("--scale-min", "1"))
scale_max <- as.numeric(arg_value("--scale-max", "5"))
if (!file.exists(input)) {
  cat(paste0("Input file not found: ", input, "\n"), file = stderr())
  quit(status = 2)
}
if (!requireNamespace("scrutiny", quietly = TRUE)) {
  f <- finding_json("info", "R scrutiny run record", "R package", "Missing R package scrutiny; summary statistic feasibility check skipped.",
    "dependency_status=missing_r_package", "Install with install.packages('scrutiny').",
    "Install scrutiny and retry; missing tool does not count as data risk.", "missing_r_package", "low", "low")
  write_payload(normalizePath(input), "missing_r_package", c(f), json_path)
  quit(status = 0)
}

d <- read.csv(input, check.names = FALSE, colClasses = "character")
norm <- function(x) tolower(gsub("[ _-]", "", x))
as_num <- function(x) suppressWarnings(as.numeric(gsub(",", "", gsub("%", "", x))))
is_inconsistent <- function(x) length(x) == 1 && !is.na(x) && !as.logical(x)
cols <- names(d)
ncol <- cols[match(TRUE, norm(cols) %in% c("n", "samplesize", "cases"))]
mcol <- cols[match(TRUE, norm(cols) %in% c("mean", "means"))]
sdcol <- cols[match(TRUE, norm(cols) %in% c("sd", "std"))]
propcol <- cols[match(TRUE, norm(cols) %in% c("proportion", "prop", "rate", "ratio", "percent", "percentage"))]
findings <- c()
add <- function(level, check, row, summary, evidence, status = "ready", confidence = "medium", fp = "medium") {
  findings <<- c(findings, finding_json(level, paste0("R scrutiny ", check), paste0("row ", row), summary, evidence,
    paste0("scale=", scale_min, "-", scale_max), "Verify scale range, rounding precision, and variable type; review original counts or statistical scripts.",
    status, confidence, fp))
}

if (!is.na(ncol) && !is.na(mcol)) {
  for (i in seq_len(nrow(d))) {
    n <- as_num(d[[ncol]][i])
    m_raw <- as.character(d[[mcol]][i])
    if (is.na(n) || is.na(as_num(m_raw))) next
    ok <- tryCatch(suppressWarnings(scrutiny::grim(x = m_raw, n = as.integer(n), items = 1)), error = function(e) NA)
    if (is_inconsistent(ok)) {
      add("high", "GRIM", i, "GRIM check found mean and sample size are mathematically inconsistent under integer scoring.", paste0("N=", n, ", mean=", m_raw), "ready", "high", "medium")
    } else if (length(ok) != 1 || is.na(ok)) {
      add("info", "GRIM", i, "GRIM could not evaluate this row.", paste0("N=", n, ", mean=", m_raw), "ready", "low", "low")
    }
  }
}

grimmer_cases <- 0
debit_cases <- 0
if (!is.na(ncol) && !is.na(mcol) && !is.na(sdcol)) {
  for (i in seq_len(nrow(d))) {
    n <- as_num(d[[ncol]][i])
    m <- as_num(d[[mcol]][i])
    sd <- as_num(d[[sdcol]][i])
    m_raw <- as.character(d[[mcol]][i])
    sd_raw <- as.character(d[[sdcol]][i])
    if (is.na(n) || is.na(m) || is.na(sd)) next
    grimmer_cases <- grimmer_cases + 1
    ok_g <- tryCatch(suppressWarnings(scrutiny::grimmer(x = m_raw, sd = sd_raw, n = as.integer(n), items = 1)), error = function(e) NA)
    if (is_inconsistent(ok_g)) {
      add("high", "GRIMMER", i, "GRIMMER check found mean, SD, and sample size are mathematically inconsistent under discrete scoring.", paste0("N=", n, ", mean=", m_raw, ", SD=", sd_raw), "ready", "high", "medium")
    }
    if (m >= 0 && m <= 1 && sd >= 0 && sd <= 0.5) {
      debit_cases <- debit_cases + 1
      ok_d <- tryCatch(suppressWarnings(scrutiny::debit(x = m_raw, sd = sd_raw, n = as.integer(n))), error = function(e) NA)
      if (is_inconsistent(ok_d)) {
        add("high", "DEBIT", i, "DEBIT check found binary mean, SD, and sample size are mathematically inconsistent.", paste0("N=", n, ", binary mean=", m_raw, ", SD=", sd_raw), "ready", "high", "medium")
      }
    }
  }
}

if (!is.na(ncol) && !is.na(sdcol) && !is.na(propcol) && is.na(mcol)) {
  for (i in seq_len(nrow(d))) {
    n <- as_num(d[[ncol]][i])
    x <- as_num(d[[propcol]][i])
    sd <- as_num(d[[sdcol]][i])
    x_raw <- as.character(d[[propcol]][i])
    sd_raw <- as.character(d[[sdcol]][i])
    if (is.na(n) || is.na(x) || is.na(sd)) next
    if (x > 1 && x <= 100) x <- x / 100
    if (x >= 0 && x <= 1 && sd >= 0 && sd <= 0.5) {
      debit_cases <- debit_cases + 1
      ok_d <- tryCatch(suppressWarnings(scrutiny::debit(x = x_raw, sd = sd_raw, n = as.integer(n))), error = function(e) NA)
      if (is_inconsistent(ok_d)) {
        add("high", "DEBIT", i, "DEBIT check found binary proportion, SD, and sample size are mathematically inconsistent.", paste0("N=", n, ", proportion=", x_raw, ", SD=", sd_raw), "ready", "high", "medium")
      }
    }
  }
}

findings <- c(findings, finding_json("info", "R scrutiny run record", "summary statistics table", "R scrutiny ran.",
  paste0("GRIMMER candidate rows=", grimmer_cases, "; DEBIT candidate rows=", debit_cases), "",
  "If no high-risk items were found, manual review against variable types and original data is still recommended.", "ready", "low", "low"))
write_payload(normalizePath(input), "ready", findings, json_path)
