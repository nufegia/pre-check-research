#!/usr/bin/env Rscript

args <- commandArgs(trailingOnly = TRUE)

usage <- function() {
  cat("Usage: pcr-statcheck <text.txt> --json findings.json\n", file = stderr())
}

json_escape <- function(x) {
  x <- ifelse(is.na(x), "", as.character(x))
  x <- gsub("\\\\", "\\\\\\\\", x)
  x <- gsub("\"", "\\\\\"", x)
  x <- gsub("\n", "\\\\n", x)
  x <- gsub("\r", "\\\\r", x)
  x <- gsub("\t", "\\\\t", x)
  x
}

jstr <- function(x) paste0("\"", json_escape(x), "\"")

confidence_score <- function(confidence, level) {
  if (confidence == "high") return(0.85)
  if (confidence == "medium") return(0.60)
  if (confidence == "low") return(0.30)
  if (level == "info") return(0.10)
  0.60
}

finding_json <- function(level, check, target, summary, evidence, detail, suggestion,
                         dependency_status = "ready", confidence = "medium",
                         false_positive_risk = "medium") {
  paste0(
    "{",
    "\"level\":", jstr(level), ",",
    "\"check\":", jstr(check), ",",
    "\"target\":", jstr(target), ",",
    "\"summary\":", jstr(summary), ",",
    "\"evidence\":", jstr(evidence), ",",
    "\"detail\":", jstr(detail), ",",
    "\"suggestion\":", jstr(suggestion), ",",
    "\"meaning\":", jstr(summary), ",",
    "\"normal_explanations\":", jstr("Possible benign causes include rounding, one/two-tailed testing, statistic extraction errors, or unsynchronized versions of the same result."), ",",
    "\"review_steps\":", jstr(suggestion), ",",
    "\"confidence\":", jstr(confidence), ",",
    "\"confidence_score\":", sprintf("%.2f", confidence_score(confidence, level)), ",",
    "\"false_positive_risk\":", jstr(false_positive_risk), ",",
    "\"tool_id\":\"r_statcheck\",",
    "\"tool_name\":\"R statcheck\",",
    "\"detector_runtime\":\"r\",",
    "\"dependency_status\":", jstr(dependency_status), ",",
    "\"confidence_basis\":", jstr("Generated from R statcheck parseable expressions, statistic back-calculation results, and dependency status; requires human judgment combining reporting format, one/two-tailed testing, and extraction quality."),
    "}"
  )
}

row_bool <- function(row, candidates) {
  for (candidate in candidates) {
    if (candidate %in% names(row)) {
      return(tolower(as.character(row[[candidate]])) %in% c("true", "1"))
    }
  }
  FALSE
}

row_value <- function(row, candidates, default = "") {
  for (candidate in candidates) {
    if (candidate %in% names(row)) return(as.character(row[[candidate]]))
  }
  default
}

write_payload <- function(source, input_type, dependency_status, findings, json_path) {
  payload <- paste0(
    "{\n",
    "  \"tool_id\": \"r_statcheck\",\n",
    "  \"tool_name\": \"R statcheck\",\n",
    "  \"detector_runtime\": \"r\",\n",
    "  \"dependency_status\": ", jstr(dependency_status), ",\n",
    "  \"source\": ", jstr(source), ",\n",
    "  \"input_type\": ", jstr(input_type), ",\n",
    "  \"findings\": [", paste(findings, collapse = ","), "]\n",
    "}\n"
  )
  if (!is.null(json_path)) {
    writeLines(payload, json_path, useBytes = TRUE)
  } else {
    cat(payload)
  }
}

if (length(args) < 1) {
  usage()
  quit(status = 2)
}

input <- args[[1]]
json_path <- NULL
if ("--json" %in% args) {
  pos <- match("--json", args)
  if (pos == length(args)) {
    usage()
    quit(status = 2)
  }
  json_path <- args[[pos + 1]]
}

if (!file.exists(input)) {
  cat(paste0("Input file not found: ", input, "\n"), file = stderr())
  quit(status = 2)
}

if (!requireNamespace("statcheck", quietly = TRUE)) {
  f <- finding_json(
    "info", "R statcheck run record", "R package",
    "Missing R package statcheck; in-text statistical consistency check skipped.",
    "dependency_status=missing_r_package",
    "Install with install.packages('statcheck').",
    "Install statcheck and retry; missing tool does not count as data risk.",
    "missing_r_package", "low", "low"
  )
  write_payload(normalizePath(input), "apa_statistical_text", "missing_r_package", c(f), json_path)
  quit(status = 0)
}

txt <- paste(readLines(input, warn = FALSE, encoding = "UTF-8"), collapse = "\n")
res <- tryCatch({
  out <- statcheck::statcheck(txt, messages = FALSE)
  if (is.null(out)) { data.frame() } else if (is.list(out) && "results" %in% names(out)) out$results else out
}, error = function(e) {
  data.frame(.pcr_cli_error = conditionMessage(e), stringsAsFactors = FALSE)
})

if (".pcr_cli_error" %in% names(res)) {
  f <- finding_json(
    "info", "R statcheck run record", "statcheck API",
    "R statcheck API call failed.",
    "dependency_status=error",
    res$.pcr_cli_error[[1]],
    "Verify text format, statcheck version, and input encoding, then retry.",
    "error", "low", "low"
  )
  write_payload(normalizePath(input), "apa_statistical_text", "error", c(f), json_path)
  quit(status = 0)
}

findings <- c()
if (nrow(res) > 0) {
  for (i in seq_len(nrow(res))) {
    row <- res[i, , drop = FALSE]
    error <- row_bool(row, c("Error", "error"))
    decision_error <- row_bool(row, c("Decision_Error", "decision_error"))
    if (!error && !decision_error) next
    raw <- row_value(row, c("Raw", "raw", "Source"), "APA statistical expression")
    reported <- row_value(row, c("Reported_P_Value", "reported_p"), "")
    computed <- row_value(row, c("Computed_P_Value", "computed_p"), "")
    detail <- paste(paste(names(row), as.character(row[1, ]), sep = "="), collapse = "; ")
    findings <- c(findings, finding_json(
      ifelse(decision_error, "high", "medium"),
      "R statcheck in-text statistical consistency",
      substr(raw, 1, 120),
      "R statcheck found inconsistency between in-text statistics and reported p-value.",
      paste0("Reported p=", reported, ", back-calculated p=", computed),
      detail,
      "Prioritize checking whether statistic, df, one/two-tailed test, and p-value are from the same analysis.",
      "ready",
      ifelse(decision_error, "high", "medium"),
      "medium"
    ))
  }
}

if (length(findings) == 0) {
  findings <- c(finding_json(
    "info", "R statcheck run record", "APA/NHST text",
    "R statcheck ran; no reportable inconsistencies found.",
    paste0("Text length=", nchar(txt)),
    "",
    "If the manuscript statistical expressions are not in APA/NHST format, use table summary statistics tools or manual review instead.",
    "ready", "low", "low"
  ))
}

write_payload(normalizePath(input), "apa_statistical_text", "ready", findings, json_path)
