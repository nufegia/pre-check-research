#!/usr/bin/env Rscript

args <- commandArgs(trailingOnly = TRUE)
usage <- function() cat("Usage: pcr-sprite <summary.csv> --scale-min 1 --scale-max 5 --json findings.json\n", file = stderr())
json_escape <- function(x) {
  x <- ifelse(is.na(x), "", as.character(x))
  x <- gsub("\\\\", "\\\\\\\\", x)
  x <- gsub("\"", "\\\\\"", x)
  x <- gsub("\n", "\\\\n", x)
  x <- gsub("\r", "\\\\r", x)
  x <- gsub("\t", "\\\\t", x)
  x
}
jstr <- function(x) paste0("\"", json_escape(x), "\"")
confidence_score <- function(confidence, level) {
  if (confidence == "high") return(0.85)
  if (confidence == "medium") return(0.60)
  if (confidence == "low") return(0.30)
  if (level == "info") return(0.10)
  0.60
}
arg_value <- function(flag, default = NULL) {
  if (!(flag %in% args)) return(default)
  pos <- match(flag, args)
  if (pos == length(args)) return(default)
  args[[pos + 1]]
}
finding_json <- function(level, check, target, summary, evidence, detail, suggestion,
                         dependency_status = "ready", confidence = "medium",
                         false_positive_risk = "high") {
  paste0("{",
    "\"level\":", jstr(level), ",",
    "\"check\":", jstr(check), ",",
    "\"target\":", jstr(target), ",",
    "\"summary\":", jstr(summary), ",",
    "\"evidence\":", jstr(evidence), ",",
    "\"detail\":", jstr(detail), ",",
    "\"suggestion\":", jstr(suggestion), ",",
    "\"meaning\":", jstr(summary), ",",
    "\"normal_explanations\":", jstr("Possible benign causes include scale range, mean/SD decimal precision, constraints, or mismatched rsprite2 search parameter settings."), ",",
    "\"review_steps\":", jstr(suggestion), ",",
    "\"confidence\":", jstr(confidence), ",",
    "\"confidence_score\":", sprintf("%.2f", confidence_score(confidence, level)), ",",
    "\"false_positive_risk\":", jstr(false_positive_risk), ",",
    "\"tool_id\":\"r_rsprite2\",",
    "\"tool_name\":\"R rsprite2 SPRITE\",",
    "\"detector_runtime\":\"r\",",
    "\"dependency_status\":", jstr(dependency_status), ",",
    "\"confidence_basis\":", jstr("Generated from R rsprite2 SPRITE search results, input field parseability, and dependency status; requires confirmation of scale range, precision, and constraints."),
  "}")
}
write_payload <- function(source, dependency_status, findings, json_path) {
  payload <- paste0("{\n",
    "  \"tool_id\": \"r_rsprite2\",\n",
    "  \"tool_name\": \"R rsprite2 SPRITE\",\n",
    "  \"detector_runtime\": \"r\",\n",
    "  \"dependency_status\": ", jstr(dependency_status), ",\n",
    "  \"source\": ", jstr(source), ",\n",
    "  \"input_type\": \"likert_or_integer_scale_summary\",\n",
    "  \"findings\": [", paste(findings, collapse = ","), "]\n",
    "}\n")
  if (!is.null(json_path)) writeLines(payload, json_path, useBytes = TRUE) else cat(payload)
}
decimal_places <- function(x) {
  x <- as.character(x)
  if (is.na(x) || !grepl("\\.", x)) return(0)
  nchar(sub("^[^.]*\\.", "", x))
}

if (length(args) < 1) {
  usage()
  quit(status = 2)
}
input <- args[[1]]
json_path <- arg_value("--json")
scale_min <- as.numeric(arg_value("--scale-min", "1"))
scale_max <- as.numeric(arg_value("--scale-max", "5"))
if (!file.exists(input)) {
  cat(paste0("Input file not found: ", input, "\n"), file = stderr())
  quit(status = 2)
}
if (!requireNamespace("rsprite2", quietly = TRUE)) {
  f <- finding_json("info", "R rsprite2 run record", "R package", "Missing R package rsprite2; SPRITE advanced review skipped.",
    "dependency_status=missing_r_package", "Install with install.packages('rsprite2').",
    "Install rsprite2 and retry; missing tool does not count as data risk.", "missing_r_package", "low", "low")
  write_payload(normalizePath(input), "missing_r_package", c(f), json_path)
  quit(status = 0)
}

d <- read.csv(input, check.names = FALSE, colClasses = "character")
norm <- function(x) tolower(gsub("[ _-]", "", x))
as_num <- function(x) suppressWarnings(as.numeric(gsub(",", "", gsub("%", "", x))))
cols <- names(d)
ncol <- cols[match(TRUE, norm(cols) %in% c("n", "samplesize", "cases"))]
mcol <- cols[match(TRUE, norm(cols) %in% c("mean", "means"))]
sdcol <- cols[match(TRUE, norm(cols) %in% c("sd", "std"))]
findings <- c()
if (is.na(ncol) || is.na(mcol) || is.na(sdcol)) {
  findings <- c(findings, finding_json("info", "R rsprite2 SPRITE", "summary statistics table", "Missing N, mean, or SD columns; cannot call SPRITE distribution reconstruction.",
    paste0("columns=", paste(cols, collapse = ",")), "", "Supplement N, mean, SD, and scale range and retry.", "ready", "low", "low"))
  write_payload(normalizePath(input), "ready", findings, json_path)
  quit(status = 0)
}

cases <- 0
for (i in seq_len(nrow(d))) {
  n <- as_num(d[[ncol]][i])
  m <- as_num(d[[mcol]][i])
  sd <- as_num(d[[sdcol]][i])
  m_raw <- as.character(d[[mcol]][i])
  sd_raw <- as.character(d[[sdcol]][i])
  if (is.na(n) || is.na(m) || is.na(sd)) next
  cases <- cases + 1
  res <- tryCatch({
    params <- rsprite2::set_parameters(mean = m, sd = sd, n_obs = as.integer(n),
      min_val = scale_min, max_val = scale_max, m_prec = decimal_places(m_raw),
      sd_prec = decimal_places(sd_raw))
    dist <- rsprite2::find_possible_distribution(params, seed = 20260517)
    if (is.list(dist)) {
      status <- ifelse(tolower(as.character(dist$outcome)) == "success", "possible", "not_found")
      detail <- paste0("N=", n, ", mean=", m_raw, ", SD=", sd_raw, ", scale=", scale_min, "-", scale_max,
        ", outcome=", dist$outcome, ", iterations=", dist$iterations)
    } else {
      status <- "not_found"
      detail <- paste0("N=", n, ", mean=", m_raw, ", SD=", sd_raw, ", scale=", scale_min, "-", scale_max, "; no feasible distribution found.")
    }
    list(status = status, detail = detail)
  }, error = function(e) {
    list(status = "impossible", detail = paste0("N=", n, ", mean=", m_raw, ", SD=", sd_raw, ", scale=", scale_min, "-", scale_max, "；", conditionMessage(e)))
  })
  if (res$status %in% c("impossible", "not_found")) {
    findings <- c(findings, finding_json("high", "R rsprite2 SPRITE", paste0("row ", i),
      "SPRITE could not find a discrete distribution matching the reported summary statistics.", res$detail, "",
      "Verify scale range, mean/SD decimal precision, sample size, and whether this is a discrete score summary; high-risk results should be manually reviewed against original frequencies.",
      "ready", "medium", "high"))
  }
}
findings <- c(findings, finding_json("info", "R rsprite2 run record", "summary statistics table", "R rsprite2 SPRITE ran.",
  paste0("rows attempted=", cases), "", "SPRITE is an advanced review tool; interpretation must retain scale and search parameter limitations.", "ready", "low", "medium"))
write_payload(normalizePath(input), "ready", findings, json_path)
